# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# Nothing here is required for `make check`; defaults work on a fresh clone.

# Path to the GnuCOBOL compiler when it is not on PATH.
COBC=cobc

# Set to 1 to fail (instead of skip) GnuCOBOL tests when cobc is missing. CI sets this.
CARDDEMO_REQUIRE_COBC=0

# Python used by the Makefile (defaults to .venv/bin/python when it exists).
# PYTHON=python3

# Batch program for `make run-batch` (CBACT02C, CBACT03C, CBCUS01C, CBTRN02C).
PROGRAM=CBTRN02C

# The mainframe helpers in scripts/ expect an FTP tunnel on localhost:2121 and the
# dataset prefix AWS.M2.CARDDEMO (both fixed in the scripts). Create the tunnel
# yourself, for example with ssh -L 2121:<mainframe-host>:21, and keep host names
# and credentials in ~/.netrc (chmod 600), not in this file or the repository.
