{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests",
    "smoke",
    "verification",
    "playwright.config.ts",
    "playwright.smoke.config.ts",
    "playwright.report.config.ts"
  ]
}
